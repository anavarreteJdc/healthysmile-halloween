{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HealthySmile Halloween",
  "version": "1.0.0",
  "identifier": "com.arturo.healthysmile.halloween",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HealthySmile Halloween",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
